{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gkd-subscription-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-22",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./apps/admin/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "SUBSCRIPTION_DOMAIN": "gkd.chenge.eu.org"
  },
  "kv_namespaces": [
    {
      "binding": "STATE",
      "id": "215fd3c9c2c74481bc521feadedd83e8"
    }
  ],
  "previews": {
    "vars": {
      "ENVIRONMENT": "preview",
      "SUBSCRIPTION_DOMAIN": "preview.invalid"
    },
    "kv_namespaces": [
      {
        "binding": "STATE",
        "id": "fc091077968342c1b73b22a310412947"
      }
    ],
    "observability": {
      "enabled": true
    }
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "account_id": "084099361afdf1265c20c09fb3834a6f",
  "secrets": {
    "required": ["ADMIN_PASSWORD"]
  }
}
