{
  "name": "gkd-subscription-hub",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "workspaces": [
    "apps/admin"
  ],
  "scripts": {
    "dev": "wrangler dev --var ADMIN_HOST:localhost",
    "dev:admin": "bun run --filter @gkd-hub/admin dev",
    "dev:worker": "wrangler dev --var ADMIN_HOST:localhost",
    "build:admin": "bun run --filter @gkd-hub/admin build",
    "typegen": "wrangler types --include-env=false",
    "typecheck:worker": "bun run typegen && tsc --noEmit",
    "typecheck": "bun run typecheck:worker && bun run --filter @gkd-hub/admin typecheck",
    "lint": "biome lint .",
    "format": "biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false --write .",
    "test": "vitest run",
    "deploy": "bun run build:admin && bun run typegen && wrangler deploy --secrets-file .secrets.json",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false --write . && git diff -- apps/admin/src/pages/ProjectsPage.vue apps/admin/index.html biome.json"
  },
  "dependencies": {
    "hono": "^4.10.6",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/markdown-it": "^14.1.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.48.0"
  },
  "packageManager": "bun@1.4.5"
}
